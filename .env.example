# ---------------------------------------------------------------------------
# Tech Maths — environment
# Copy to .env.local and fill in real values before production.
# ---------------------------------------------------------------------------

# Where the SQLite database file lives. Relative to the project root.
TECHMATHS_DB=./data/techmaths.db

# Public canonical origin used for sitemap.xml, robots.txt, og:url and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://techmaths-dc.com

# Lead routing: where quote requests are forwarded (SMTP/Resend/CRM webhook).
LEAD_NOTIFY_EMAIL=sales@techmaths-dc.com
LEAD_WEBHOOK_URL=

# Admin console session secret + passcode. Change both in production.
ADMIN_TOKEN=use-a-long-unique-passphrase
ADMIN_COOKIE_SECRET=change-me-too

# Privacy-friendly analytics (Plausible / self-hosted Umami). Empty = off.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
