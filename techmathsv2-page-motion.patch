+/* Page-specific technical motion scenes. These styles are opt-in and are not used on the homepage. */
+@keyframes tm-page-enter {
+  from { opacity: 0; filter: blur(2px); }
+  to { opacity: var(--tm-page-scene-opacity, 0.82); filter: blur(0); }
+}
+@keyframes tm-page-trace {
+  to { stroke-dashoffset: 0; }
+}
+@keyframes tm-page-beacon {
+  0%, 100% { opacity: 0.9; transform: scale(1); }
+  50% { opacity: 0.42; transform: scale(0.76); }
+}
+@keyframes tm-page-spin {
+  to { transform: rotate(360deg); }
+}
+@keyframes tm-page-lift {
+  0%, 100% { transform: translateY(0); }
+  50% { transform: translateY(-3px); }
+}
+@keyframes tm-page-sweep {
+  0%, 25% { transform: translateX(-130%); opacity: 0; }
+  40% { opacity: 0.65; }
+  65%, 100% { transform: translateX(530%); opacity: 0; }
+}
+
+.tm-page-scene {
+  position: absolute;
+  z-index: 0;
+  top: 52%;
+  right: clamp(1.25rem, 5vw, 5.5rem);
+  width: min(35vw, 430px);
+  transform: translateY(-50%);
+  pointer-events: none;
+  --tm-page-scene-opacity: 0.82;
+  opacity: var(--tm-page-scene-opacity);
+  animation: tm-page-enter 900ms var(--ease-out-expo) both;
+}
+.tm-page-scene__frame {
+  position: relative;
+  overflow: hidden;
+  border: 1px solid color-mix(in srgb, var(--tm-accent) 24%, var(--tm-line));
+  border-radius: 20px;
+  background:
+    radial-gradient(ellipse at 50% 50%, color-mix(in srgb, var(--tm-accent) 8%, transparent), transparent 68%),
+    linear-gradient(145deg, color-mix(in srgb, var(--tm-panel) 96%, transparent), color-mix(in srgb, var(--tm-ink-2) 92%, transparent));
+  box-shadow: 0 22px 90px -48px var(--tm-glow), inset 0 1px 0 color-mix(in srgb, white 5%, transparent);
+  isolation: isolate;
+}
+.tm-page-scene__frame::after {
+  position: absolute;
+  z-index: 2;
+  inset: -10% auto -10% 0;
+  width: 18%;
+  content: "";
+  background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--tm-accent) 9%, transparent), transparent);
+  transform: translateX(-130%);
+  animation: tm-page-sweep 11s ease-in-out 1.5s infinite;
+}
+.tm-page-scene__header,
+.tm-page-scene__footer {
+  position: relative;
+  z-index: 3;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.75rem;
+  padding-inline: 1rem;
+  color: var(--tm-mute);
+  font: 500 0.55rem/1.2 var(--tm-font-mono);
+  letter-spacing: 0.15em;
+  text-transform: uppercase;
+}
+.tm-page-scene__header { padding-top: 0.9rem; }
+.tm-page-scene__footer {
+  min-height: 2.25rem;
+  padding-bottom: 0.85rem;
+  letter-spacing: 0.08em;
+  text-transform: none;
+}
+.tm-page-scene__status { display: inline-flex; align-items: center; gap: 0.4rem; white-space: nowrap; }
+.tm-page-scene__status i {
+  width: 5px;
+  height: 5px;
+  border-radius: 50%;
+  background: var(--tm-accent);
+  box-shadow: 0 0 10px var(--tm-glow);
+  animation: tm-page-beacon 2.6s ease-in-out infinite;
+}
+.tm-page-scene__svg { position: relative; z-index: 1; display: block; width: 100%; height: auto; }
+.tm-page-scene__hairline { stroke: var(--tm-line); stroke-width: 1; }
+.tm-page-scene__line {
+  fill: none;
+  stroke: var(--tm-mist);
+  stroke-opacity: 0.27;
+  stroke-width: 1.25;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+.tm-page-scene__line--accent {
+  stroke: var(--tm-accent);
+  stroke-opacity: 0.9;
+  filter: drop-shadow(0 0 4px var(--tm-glow));
+}
+.tm-page-scene__line--draw {
+  stroke: var(--tm-accent);
+  stroke-opacity: 0.76;
+  stroke-dasharray: 520;
+  stroke-dashoffset: 520;
+  animation: tm-page-trace 2.4s var(--ease-out-expo) 160ms forwards;
+}
+.tm-page-scene__node {
+  fill: var(--tm-accent);
+  stroke: var(--tm-ink);
+  stroke-width: 1.5;
+  transform-box: fill-box;
+  transform-origin: center;
+  animation: tm-page-beacon 3.2s ease-in-out infinite;
+}
+.tm-page-scene__node--soft { fill: var(--tm-mist); opacity: 0.68; }
+.tm-page-scene__core {
+  fill: color-mix(in srgb, var(--tm-accent) 13%, var(--tm-panel));
+  stroke: color-mix(in srgb, var(--tm-accent) 70%, transparent);
+  stroke-width: 1.2;
+}
+.tm-page-scene__chip,
+.tm-page-scene__bay {
+  fill: color-mix(in srgb, var(--tm-panel-2) 76%, transparent);
+  stroke: var(--tm-line-strong);
+  stroke-width: 1;
+}
+.tm-page-scene__bay--active {
+  fill: color-mix(in srgb, var(--tm-accent) 13%, var(--tm-panel));
+  stroke: color-mix(in srgb, var(--tm-accent) 65%, transparent);
+}
+.tm-page-scene__bay--empty {
+  fill: color-mix(in srgb, var(--tm-accent) 7%, var(--tm-panel));
+  stroke: var(--tm-accent);
+  stroke-dasharray: 3 4;
+}
+.tm-page-scene__track { fill: var(--tm-line-strong); }
+.tm-page-scene__progress { fill: var(--tm-accent); filter: drop-shadow(0 0 4px var(--tm-glow)); }
+.tm-page-scene__map {
+  fill: color-mix(in srgb, var(--tm-accent) 7%, var(--tm-panel));
+  stroke: color-mix(in srgb, var(--tm-accent) 38%, var(--tm-line-strong));
+  stroke-width: 1;
+}
+.tm-page-scene__orbit {
+  fill: none;
+  stroke: color-mix(in srgb, var(--tm-accent) 48%, transparent);
+  stroke-width: 1;
+  stroke-dasharray: 2 7;
+  transform-box: fill-box;
+  transform-origin: center;
+  animation: tm-page-spin 38s linear infinite;
+}
+.tm-page-scene__halo {
+  fill: color-mix(in srgb, var(--tm-accent) 11%, transparent);
+  stroke: color-mix(in srgb, var(--tm-accent) 34%, transparent);
+  stroke-width: 1;
+  transform-box: fill-box;
+  transform-origin: center;
+  animation: tm-page-beacon 3.4s ease-in-out infinite;
+}
+.tm-page-scene__lift { transform-box: fill-box; transform-origin: center; animation: tm-page-lift 4.6s ease-in-out infinite; }
+.tm-page-scene__svg-label {
+  fill: var(--tm-accent);
+  font: 600 7px/1 var(--tm-font-mono);
+  letter-spacing: 0.7px;
+}
+.tm-page-scene__micro {
+  fill: var(--tm-mute);
+  font: 500 6px/1 var(--tm-font-mono);
+  letter-spacing: 0.7px;
+}
+@media (max-width: 1023px) {
+  .tm-page-scene { top: 35%; right: 3%; width: min(34vw, 320px); --tm-page-scene-opacity: 0.32; opacity: var(--tm-page-scene-opacity); }
+}
+@media (max-width: 639px) {
+  .tm-page-scene { top: 0.75rem; right: -1.5rem; width: 155px; transform: none; --tm-page-scene-opacity: 0.19; opacity: var(--tm-page-scene-opacity); }
+  .tm-page-scene__frame { border-radius: 14px; }
+  .tm-page-scene__header,
+  .tm-page-scene__footer { padding-inline: 0.6rem; font-size: 0.42rem; }
+  .tm-page-scene__footer { min-height: 1.7rem; }
+}
+.tm-page-scene--service-detail {
+  top: 72%;
+  width: min(28vw, 360px);
+  --tm-page-scene-opacity: 0.56;
+  opacity: var(--tm-page-scene-opacity);
+}
+@media (max-width: 1023px) {
+  .tm-page-scene--service-detail { top: 57%; width: min(31vw, 300px); --tm-page-scene-opacity: 0.27; opacity: var(--tm-page-scene-opacity); }
+}
+@media (max-width: 639px) {
+  .tm-page-scene--service-detail { top: 0.75rem; right: -1.5rem; width: 125px; --tm-page-scene-opacity: 0.13; opacity: var(--tm-page-scene-opacity); }
+}
+.tm-page-scene--portal {
+  top: 50%;
+  right: max(4vw, 2rem);
+  width: min(30vw, 360px);
+  --tm-page-scene-opacity: 0.28;
+  opacity: var(--tm-page-scene-opacity);
+}
+@media (max-width: 900px) {
+  .tm-page-scene--portal { display: none; }
+}
+
 /* Reduced motion + manual motion-off switch ------------------------------ */
 @media (prefers-reduced-motion: reduce) {
   html { scroll-behavior: auto; }
