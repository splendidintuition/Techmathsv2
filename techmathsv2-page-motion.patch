+/** Small, page-specific animated schematic. Deliberately not used on the homepage. */
+export function PageScene({
+  variant,
+  context,
+  className = "",
+}: {
+  variant: string;
+  context?: string;
+  className?: string;
+}) {
+  const kind = PAGE_SCENES[variant] ?? SERVICE_SCENES[variant] ?? "services";
+  const copy = SCENE_COPY[kind];
+
+  return (
+    <div className={`tm-page-scene tm-page-scene--${kind} ${className}`} aria-hidden="true">
+      <div className="tm-page-scene__frame">
+        <div className="tm-page-scene__header">
